rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // True when the person is signed in.
    function signedIn() { return request.auth != null; }

    // Users can only read and change their own profile and their own completed recipes.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;

      match /completed/{recipeId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }

      // Notifications. Only the owner can read them, mark them as read or delete them.
      // Anyone signed in can send one to someone else, but only in their own name (fromUid)
      // and it must start as unread. Nobody can send a notification to themselves.
      match /notifications/{notificationId} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow update: if signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow create: if signedIn()
          && request.auth.uid != uid
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.toUid == uid
          && request.resource.data.read == false
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 120
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 400;
      }
    }

    // Anyone signed in can read recipes. Only the person who added a recipe can change or delete it.
    match /recipes/{recipeId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.authorUid == request.auth.uid;

      // Anyone signed in can read reviews and add one in their own name (1 to 5 stars).
      // Only the person who wrote a review can delete it.
      match /reviews/{reviewId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.userUid == request.auth.uid
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5;
        allow delete: if signedIn() && resource.data.userUid == request.auth.uid;
      }
    }
  }
}
