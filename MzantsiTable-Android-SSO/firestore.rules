rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Each user can only read/write their own profile, saved recipes and completed recipes.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;

      match /completed/{recipeId} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // Any signed-in user can read recipes; only the author can create/edit/delete their own.
    match /recipes/{recipeId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.authorUid == request.auth.uid;
    }
  }
}
